auto-install-peers=false

# SUP-20840: a user-level `force=true` (e.g. the one in the Paperclip server's
# HOME .npmrc) makes pnpm install every platform's optional binaries (codex,
# claude-agent-sdk, opencode: ~10 GB per worktree instead of ~3 GB), and
# pnpm.supportedArchitectures cannot narrow that. The project .npmrc beats the
# user one, so pin it off; pass `pnpm install --force` explicitly to opt in.
force=false
