DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
# Optional: elevated connection for DDL migrations. Falls back to DATABASE_URL
# when unset. In production, set DATABASE_URL to the least-privilege
# paperclip_serving role and DATABASE_MIGRATION_URL to the superuser.
DATABASE_MIGRATION_URL=
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# CodeRabbit CLI credentials for the agent fleet. The CLI is installed in the
# image; this is what makes `coderabbit review --agent` work headless, without
# it falling back to an interactive browser sign-in that never completes in a
# container. Optional — leave unset to ship the CLI signed out.
#
# The CLI reads only $HOME/.coderabbit/auth.json and ignores CODERABBIT_API_KEY
# at review time, so credentials are handed over as that file, base64-encoded.
# Authenticate once on a workstation, then capture it:
#   coderabbit auth login
#   base64 -w0 ~/.coderabbit/auth.json
# auth.json is portable across machines and OAuth tokens do not expire.
# CODERABBIT_AUTH_JSON_B64=
#
# Alternative for organizations issuing API keys: set this instead and the
# entrypoint exchanges it for stored credentials on first boot (one network
# call to CodeRabbit, non-fatal if it fails).
# CODERABBIT_API_KEY=
